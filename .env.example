# Node.js 26.11.1 Current；正式環境亦可使用經驗證的 Node.js 24 LTS。
HOST=127.0.0.1
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000
# mariadb 或 redis；只會連接所選資料來源
DATA_BACKEND=mariadb
# 必須替換為至少 32 字元隨機秘密，多節點需相同；不要放入 Members.html
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
MAX_INFLIGHT=64
PER_SOCKET_RPS=5
MAX_CONNECTIONS=6000
# MariaDB TCP：IPv6 直接填 ::1，不加 []。Socket path 非空時改走 Unix socket。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET_PATH=
DB_USER=members_app
DB_PASSWORD="change-me"
DB_DATABASE=members_demo
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=5000
DB_ACQUIRE_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_SECONDS=60
DB_QUERY_TIMEOUT_MS=3000
DB_SOCKET_TIMEOUT_MS=5000
DB_TLS=false
# 系統信任 CA 可留空；私有 CA 填 PEM 路徑
DB_TLS_CA=
DB_TLS_CERT=
DB_TLS_KEY=
DB_TLS_SERVERNAME=
# 驗證憑證固定開啟，不提供略過驗證
# Redis：ACL 帳號；留空代表預設帳號。DB 為數字資料庫編號。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_SOCKET_PATH=
REDIS_USERNAME=default
REDIS_PASSWORD="change-me"
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_RECONNECT_MAX_MS=3000
REDIS_MAX_COMMAND_QUEUE=256
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_SERVERNAME=
# 以下供資料初始化、測試 token 及負載測試使用
TENANT_ID=demo
SEED_COUNT=1000
LOAD_URL=http://localhost:3000
LOAD_CLIENTS=100
LOAD_RAMP_PER_SECOND=20
LOAD_DURATION_SECONDS=60
LOAD_INTERVAL_MS=1000
